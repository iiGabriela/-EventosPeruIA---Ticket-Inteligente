@host = http://localhost:5295
# Correo de un usuario que exista en la tabla "usuario" (Firebase solo valida el login).
# El header X-User-Email solo funciona en Development; en producción va el token de Firebase.
@email = hugo.prueba@correo.com

### ===================== Antes de probar (endpoints de Gabriela) =====================
# 1) Registrarse (crea el usuario como ASISTENTE)
POST {{host}}/api/Usuario/registro
Content-Type: application/json
X-User-Email: {{email}}

{
  "nombre": "Hugo Flores",
  "dni": "10000001"
}

### 2) Activar el rol ORGANIZADOR (necesario para crear eventos)
POST {{host}}/api/Usuario/me/rol-organizador
X-User-Email: {{email}}

### ===================== US-05: Categorías =====================
GET {{host}}/api/Categoria
Accept: application/json

###
GET {{host}}/api/Categoria/populares?cantidad=4
Accept: application/json

### ===================== US-05: Búsqueda de eventos =====================
GET {{host}}/api/Evento?texto=rock&categoriaId=2&ubicacion=Miraflores&fechaDesde=2026-10-01&fechaHasta=2026-12-31&pagina=1&tamanoPagina=12
Accept: application/json

###
GET {{host}}/api/Evento/1
Accept: application/json

### ===================== US-04: Mis eventos =====================
GET {{host}}/api/Evento/mis-eventos
X-User-Email: {{email}}

### Crear evento (queda en BORRADOR)
POST {{host}}/api/Evento
Content-Type: application/json
X-User-Email: {{email}}

{
  "categoriaId": 1,
  "nombre": "Conferencia de IA aplicada",
  "descripcion": "Charlas sobre LLMs, embeddings y RAG.",
  "imagenUrl": null,
  "fechaInicio": "2026-11-20T19:00:00",
  "fechaFin": "2026-11-20T22:00:00",
  "sede": "Centro de Convenciones",
  "direccion": "Av. Javier Prado 123",
  "departamento": "Lima",
  "provincia": "Lima",
  "distrito": "San Isidro",
  "aforoTotal": 200,
  "precio": 50.00
}

### Editar evento
PUT {{host}}/api/Evento/1
Content-Type: application/json
X-User-Email: {{email}}

{
  "eventoId": 1,
  "categoriaId": 1,
  "nombre": "Conferencia de IA aplicada 2026",
  "descripcion": "Charlas sobre LLMs, embeddings y RAG.",
  "imagenUrl": null,
  "fechaInicio": "2026-11-20T19:30:00",
  "fechaFin": "2026-11-20T22:30:00",
  "sede": "Centro de Convenciones",
  "direccion": "Av. Javier Prado 123",
  "departamento": "Lima",
  "provincia": "Lima",
  "distrito": "San Isidro",
  "aforoTotal": 250,
  "precio": 60.00
}

### Publicar evento
PUT {{host}}/api/Evento/1/publicar
X-User-Email: {{email}}

### Cancelar evento
PUT {{host}}/api/Evento/1/cancelar
X-User-Email: {{email}}

### ===================== US-11: Panel de ventas =====================
# periodo: TODO | MES | SEMANA  (o fechaDesde / fechaHasta)
GET {{host}}/api/Venta/panel?periodo=TODO
X-User-Email: {{email}}

### ===================== US-12: Exportar =====================
GET {{host}}/api/Venta/exportar/excel?periodo=MES
X-User-Email: {{email}}

###
GET {{host}}/api/Venta/exportar/pdf?fechaDesde=2026-10-01&fechaHasta=2026-10-31
X-User-Email: {{email}}

### ===================== US-07 / US-08: QR dinámico y check-in =====================
# 1) Mis entradas (pase completo, sin el código secreto)
GET {{host}}/api/Entrada/mis-entradas
X-User-Email: {{email}}

### 2) QR dinámico de una entrada (vence en 24 s; el frontend lo pide de nuevo antes)
@entradaId = 1
GET {{host}}/api/Entrada/{{entradaId}}/qr
X-User-Email: {{email}}

### 3) Check-in escaneando el QR (pegar el "token" del paso 2; lo hace el organizador)
POST {{host}}/api/Entrada/validar
Content-Type: application/json
X-User-Email: {{email}}

{
  "eventoId": 1,
  "codigoQr": "pegar-token-aqui"
}

### 4) Check-in manual: ID de la entrada + DNI del titular
POST {{host}}/api/Entrada/validar
Content-Type: application/json
X-User-Email: {{email}}

{
  "eventoId": 1,
  "entradaId": {{entradaId}},
  "titularDocumento": "12345678"
}
